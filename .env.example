DOMAIN=beergame.io
ACME_EMAIL=replace-with-your-email@example.com
PUBLIC_ORIGIN=https://beergame.io
# Default production indexing is off until release review is complete.
INDEXABLE=false
# Empty uses the server default: Google's public STUN, or stun:stun.cloudflare.com:3478 with Cloudflare TURN.
STUN_URLS=
# Cloudflare Realtime TURN: short-lived credentials for each player (TTL in seconds, default 10800, 3 hours). Keep the API token private.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
TURN_TTL_SECONDS=
# Or a static TURN relay instead of Cloudflare (not both). /rtc-config gives these credentials to every browser.
TURN_URLS=
TURN_USERNAME=
TURN_PASSWORD=
